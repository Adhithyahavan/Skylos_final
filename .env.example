# ═══════════════════════════════════════════════════════════════
# AI-SIEM Guardian — Environment Configuration Example
# ═══════════════════════════════════════════════════════════════
#
# SECURITY INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
# 2. Replace ALL placeholder values with secure, randomly generated values
# 3. NEVER commit .env to version control
# 4. Use different secrets for development, staging, and production
#
# Generate secure random keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_NAME=AI-SIEM Guardian
APP_VERSION=1.0.0
DEBUG=false

# ── Database ────────────────────────────────────────────────────
# SQLite (Development):
# DATABASE_URL=sqlite:///./siem_guardian.db

# PostgreSQL (Production - REQUIRED):
DATABASE_URL=postgresql://siem_user:CHANGE_THIS_PASSWORD@localhost:5432/siem_db

# PostgreSQL connection details (for Docker and external tools)
POSTGRES_USER=siem_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=siem_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── JWT Authentication ──────────────────────────────────────────
# CRITICAL: Generate a secure random key for production
# Never use the default value in any real deployment
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── CORS Configuration ──────────────────────────────────────────
# Comma-separated list of allowed origins
# Development:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Production (replace with your actual domains):
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# ── SMTP Email Alerts (Optional) ────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-specific-password
ALERT_EMAIL_TO=security-team@example.com

# ── AI Engine ───────────────────────────────────────────────────
# Contamination: Expected proportion of anomalies (0.01 = 1%, 0.1 = 10%)
ANOMALY_CONTAMINATION=0.1
MIN_TRAINING_SAMPLES=20

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ── Network Analyzer ────────────────────────────────────────────
# Enable real packet capture (requires Npcap/libpcap)
ENABLE_REAL_CAPTURE=false
CAPTURE_INTERFACE=eth0
PACKET_COUNT=100

# ── Agent Configuration ─────────────────────────────────────────
BACKEND_URL=http://localhost:8000
# REQUIRED. Agents are rejected when this is empty (fail closed).
AGENT_API_KEY=CHANGE_THIS_TO_A_SECURE_AGENT_KEY

# ── First-run Administrator ─────────────────────────────────────
# There is no default administrator. Either run
#   python manage.py create-admin --username <name> --email <email>
# from the backend directory, or set all three variables below. They are only
# used while no administrator exists; remove the password after first start.
SKYLOS_BOOTSTRAP_ADMIN_USERNAME=
SKYLOS_BOOTSTRAP_ADMIN_EMAIL=
SKYLOS_BOOTSTRAP_ADMIN_PASSWORD=

# ── WebSocket ───────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30

# ── Security Headers ────────────────────────────────────────────
ENABLE_SECURITY_HEADERS=true

# ── Session Management ──────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS_PER_USER=5

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Log every SQL statement with bound parameters. Leave false: parameters can
# include password hashes and encrypted credentials.
SQL_ECHO=false
LOG_FILE=logs/siem_guardian.log

# ── Secret Provider / Database Guardian credential encryption ──
# Secret provider used to encrypt stored database credentials. Supported: fernet
SECRET_PROVIDER=fernet

# REQUIRED. The backend refuses to start if this is missing or invalid; no key
# is ever generated automatically. Must be a Fernet key (44 characters).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat it like a password: never commit it, never share it, back it up
# separately from the database. Changing or losing it makes every stored
# database credential unreadable (they must then be re-entered).
DB_ENCRYPTION_KEY=UTjLRD3SRdmQDTdd8OCg9ieTp-l_KCZLK1IBD9L7BXo=

# Background monitoring of registered databases (true/false)
DB_GUARDIAN_MONITORING_ENABLED=true

# Monitoring intervals (in seconds)
DB_MONITOR_HEALTH_INTERVAL=300   # 5 minutes
DB_MONITOR_LOGIN_INTERVAL=60     # 1 minute
DB_MONITOR_QUERY_INTERVAL=60     # 1 minute

# ── Synthetic Database Guardian test target (docker compose --profile guardian-test)
GUARDIAN_TEST_DB_NAME=test_company_db
GUARDIAN_TEST_DB_USER=monitor_user
GUARDIAN_TEST_DB_PASSWORD=

# ── Backup Configuration ────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
